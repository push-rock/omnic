{
  "problemMatcher": [
    {
      "owner": "gcc",
      "pattern": [
        {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?error:\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": "error",
          "message": 4
        }
      ]
    }
  ]
}
