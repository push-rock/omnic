{
  "problemMatcher": [
    {
      "owner": "gcc",
      "pattern": [
        {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?error:\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "ld",
      "pattern": [
        {
          "regexp": "^.*undefined reference to `(.+)'.*$",
          "message": 1
        }
      ]
    },
    {
      "owner": "make",
      "pattern": [
        {
          "regexp": "^(.+?):\\s+\\*\\*\\*\\s+\\[(.+)\\]\\s+Error\\s+\\d+.*$",
          "message": 2
        }
      ]
    }
  ]
}
