# omnic architecture — the pack pipeline.
# Render with:
#   d2 --layout=tala architecture.d2 architecture.svg
#   d2 --layout=tala architecture.d2 architecture.png --scale=2
# Grammar follows the ffmpeg docs diagrams: components as boxes,
# artifacts as endpoints, every arrow labeled with what flows.

vars: {
  blue: "#4C72B0"
  red: "#C44E52"
  ink: "#2F2F2F"
  pale: "#F1F5FA"
  line: "#8C8C8C"
}

direction: down

classes: {
  entry: { style: { fill: "${blue}"; stroke: "${blue}"; font-color: "#FFFFFF"; border-radius: 10 } }
  stage: { style: { fill: "${pale}"; stroke: "#9FB3D9"; font-color: "${ink}"; border-radius: 8 } }
  hero:  { style: { fill: "#FFFFFF"; stroke: "${red}"; stroke-width: 2; font-color: "${ink}"; border-radius: 8 } }
  out:   { style: { fill: "#FAFAFA"; stroke: "#C9C9C9"; font-color: "${ink}"; border-radius: 8 } }
}

cli: {
  label: |md
    **CLI / C API**

    c · d · pack · unpack · analyze · list
  |
  class: entry
}

adapters: {
  label: |md
    **1 · format adapters**

    identify every incoming file

    14 magic sniffers — magic first, extension fallback
  |
  class: stage
}

decider: {
  label: |md
    **2 · decider**

    picks the right codec per file, ~1 ms

    3-segment sample · 8 features · 7 content classes
  |
  class: stage
}

codecs: {
  label: |md
    **3 · codec pool**

    16 vendored codecs do the compressing

    zstd · lz4 · xz · brotli · snappy · …

    encode runs threaded in worker pools
  |
  class: stage
}

container: {
  label: |md
    **4 · .omnic container**

    packs blocks + index + double CRC

    a corrupt block is isolated — the rest extracts
  |
  class: hero
}

archive: {
  label: "archive.omnic"
  shape: document
  class: out
}

e1: cli -> adapters { label: "input files"; style: { stroke: "${line}" } }
e2: adapters -> decider { label: "type + stats"; style: { stroke: "${line}" } }
e3: decider -> codecs { label: "chosen codec"; style: { stroke: "${line}" } }
e4: codecs -> container { label: "compressed blocks"; style: { stroke: "${line}" } }
e5: container -> archive { label: "write"; style: { stroke: "${line}" } }

note: {
  label: |md
    d / unpack runs the reverse pipeline — every block CRC-checked, corrupt blocks isolated, the rest extracts.

    a new codec is one file (src/codec/ac_*.c) plus one registry entry.
  |
  near: bottom-center
  style.font-color: "#666666"
}
